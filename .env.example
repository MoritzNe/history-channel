# Copy to .env and fill in. Never commit .env.

# Claude API key for script generation (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=
# Claude model id for script generation; empty = claude-opus-5-5
HC_MODEL=
# Effort for script passes: low | medium | high | xhigh | max; empty = high
HC_EFFORT=
# ElevenLabs API key for premium TTS narration (optional; local Kokoro is the default)
ELEVENLABS_API_KEY=
# fal.ai key for generated images (optional; only used for `generated` visuals)
FAL_KEY=
# OpenAI key (optional; alternative image/TTS provider)
OPENAI_API_KEY=
# Path to the OAuth "Desktop app" client JSON downloaded from Google Cloud (see docs/tools-upload.md)
YOUTUBE_CLIENT_SECRET=client_secret.json
